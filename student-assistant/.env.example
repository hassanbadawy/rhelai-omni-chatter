# Copy to .env and fill in.

# Llama Stack server (from docker-compose.yml above, or any OpenAI-compatible endpoint)
LLAMA_STACK_URL=http://localhost:8321

# Docling server
DOCLING_URL=http://localhost:5001

# LLM identifier as registered with Llama Stack.
# If using Ollama via Llama Stack: ollama/qwen2.5:7b-instruct
# If using a custom vLLM provider: vllm/qwen25-7b-instruct (note the slash)
LLM_MODEL=ollama/qwen2.5:7b-instruct

# Local SQLite + storage roots. Defaults if unset:
SQLITE_PATH=~/.student-assistant/db.sqlite3
STORAGE_ROOT=~/.student-assistant/storage

# Hard-coded MVP1 student id. Don't change after the first run; data is keyed to this.
MVP1_STUDENT_ID=student-mvp1

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
